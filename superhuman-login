#!/bin/bash
# Superhuman Linux Login Helper
#
# Superhuman has no official Linux client, so the server-side Google OAuth
# flow doesn't hand off to the app via the superhuman:// scheme on Linux -
# it redirects to a real https://mail.superhuman.com/~login#... URL instead,
# and the page falls back to browser-only onboarding if nothing intercepts
# that URL fast enough. This script converts that URL and passes it to the
# already-running app, completing sign-in manually.
#
# Usage:
#   1. Click "Sign in with Google" in the app and complete Google auth.
#   2. Immediately copy the URL from the browser's address bar (it should
#      start with https://mail.superhuman.com/~login#...).
#   3. Run: superhuman-login 'that URL'  (quote it - it contains # and &)

URL="$1"

if [ -z "$URL" ]; then
    echo "Usage: superhuman-login 'OAUTH_URL'"
    echo ""
    echo "After clicking 'Sign in with Google' and completing Google auth,"
    echo "copy the full URL from your browser's address bar"
    echo "(it should start with https://mail.superhuman.com/~login#...)"
    echo "and pass it to this script."
    exit 1
fi

if [[ "$URL" == https://mail.superhuman.com/* ]]; then
    CONVERTED=$(echo "$URL" | sed 's|https://mail.superhuman.com/|superhuman://|')
elif [[ "$URL" == superhuman://* ]]; then
    CONVERTED="$URL"
    if [[ "$CONVERTED" == superhuman://login* ]]; then
        CONVERTED="${CONVERTED/superhuman:\/\/login/superhuman://~login}"
    fi
else
    echo "Error: URL must start with https://mail.superhuman.com/ or superhuman://"
    exit 1
fi

echo "Logging in..."
exec /opt/superhuman/superhuman "$CONVERTED"
